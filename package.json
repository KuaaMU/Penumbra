{
  "name": "penumbra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "An ambient, spatial AI collaborative system for deep cognitive flow. No chat UI: every interaction is a node on an infinite canvas.",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "test:perf": "cross-env PENUMBRA_PERF=1 vitest run",
    "test:e2e": "playwright test",
    "mcp:verify": "echo \"[mcp:verify] Phase 4 — not yet implemented\" && exit 0"
  },
  "dependencies": {
    "rbush": "~4.0.1",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "y-indexeddb": "~9.0.12",
    "yjs": "~13.6.33",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@playwright/test": "~1.63.0",
    "@tailwindcss/vite": "~4.3.3",
    "@types/node": "~26.6.4",
    "@types/rbush": "~4.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.1.2",
    "cross-env": "~10.1.0",
    "eslint": "~10.12.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "globals": "~17.13.0",
    "jsdom": "~30.1.2",
    "prettier": "~3.9.9",
    "tailwindcss": "~4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.1",
    "vite": "~8.3.3",
    "vitest": "~5.0.3"
  }
}
